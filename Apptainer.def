Bootstrap: docker
From: nvidia/cuda:12.2.0-runtime-ubuntu22.04

%arguments
    # Install optional features that currently resolve together. MRIQC and
    # Nifreeze are excluded for now because their nitransforms requirements
    # conflict.
    PYTHON_EXTRAS=amico,nexi,pyafq,hdbet,synb0,tracker,reporting,viewer

%labels
    Author Dean
    Version 0.0.1
    Description qmri-neuropipe container (CUDA + FSL + FreeSurfer + ANTs + MRtrix3)
    License MIT

%files
    # Build from the repository root. Copy only package inputs so that local
    # datasets, build products, Git history, and existing images cannot be
    # included accidentally.
    pyproject.toml /app/pyproject.toml
    src /app/src
    container-assets /opt/container-assets

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    export CONDA_DIR=/opt/conda
    export PATH=${CONDA_DIR}/bin:$PATH
    export MAMBA_ROOT_PREFIX=/tmp/micromamba-root

    FREESURFER_VERSION="${FREESURFER_VERSION:-8.2.0}"
    FREESURFER_PACKAGE="${FREESURFER_PACKAGE:-freesurfer_ubuntu22-8.2.0_amd64.deb}"
    FREESURFER_URL="${FREESURFER_URL:-https://surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/${FREESURFER_VERSION}/${FREESURFER_PACKAGE}}"

    # The default FreeSurfer package below targets version 8.2.0 for Ubuntu 22.

    # --------------------------------------------------------------------------------
    # 1. System dependencies
    # --------------------------------------------------------------------------------
    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        curl \
        ca-certificates \
        gnupg \
        git \
        build-essential \
        sudo \
        bzip2 \
        bc \
        dc \
        file \
        tcsh \
        perl \
        locales \
        libgl1 \
        libglu1-mesa \
        libfontconfig1 \
        libfreetype6 \
        libxrender1 \
        libxext6 \
        libx11-6 \
        libsm6 \
        libxi6 \
        libxmu6 \
        libxkbcommon0 \
        libdbus-1-3 && \
        rm -rf /var/lib/apt/lists/*

    # --------------------------------------------------------------------------------
    # 2. Micromamba and core neuroimaging binaries
    # --------------------------------------------------------------------------------
    mkdir -p /usr/local/bin
    wget -qO- https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj -C /tmp bin/micromamba
    install -m 0755 /tmp/bin/micromamba /usr/local/bin/micromamba
    rm -rf /tmp/bin

    micromamba create -y -p ${CONDA_DIR} -c mrtrix3 -c conda-forge \
        python=3.10 \
        pip \
        numpy \
        cython \
        imagecodecs \
        mrtrix3 \
        ants \
        afni \
        dcm2niix
    micromamba clean --all --yes

    # --------------------------------------------------------------------------------
    # 3. FSL
    # --------------------------------------------------------------------------------
    export FSLDIR=/usr/local/fsl
    export PATH=${CONDA_DIR}/bin:${FSLDIR}/bin:$PATH
    curl -fsSL https://fsl.fmrib.ox.ac.uk/fsldownloads/fslconda/releases/fslinstaller.py -o /tmp/fslinstaller.py
    python3 /tmp/fslinstaller.py -d ${FSLDIR} -q --no_env
    rm /tmp/fslinstaller.py

    # --------------------------------------------------------------------------------
    # 4. FreeSurfer
    # --------------------------------------------------------------------------------
    export FREESURFER_HOME="/usr/local/freesurfer/${FREESURFER_VERSION}"
    mkdir -p ${FREESURFER_HOME}
    wget -O /tmp/freesurfer.deb ${FREESURFER_URL}
    apt-get update
    apt-get install -y --no-install-recommends /tmp/freesurfer.deb
    rm -f /tmp/freesurfer.deb
    rm -rf /var/lib/apt/lists/*
    FS_ACTUAL_HOME=""
    for candidate in \
        "${FREESURFER_HOME}" \
        "/usr/local/freesurfer/${FREESURFER_VERSION%.*}" \
        "/usr/local/freesurfer" \
        "/opt/freesurfer"; do
        if [ -x "${candidate}/bin/mri_convert" ]; then
            FS_ACTUAL_HOME="${candidate}"
            break
        fi
    done
    if [ -z "${FS_ACTUAL_HOME}" ]; then
        echo "Could not locate FreeSurfer install root after package install." >&2
        find /usr/local -maxdepth 3 -type f -name mri_convert >&2 || true
        exit 1
    fi
    export FREESURFER_HOME="${FS_ACTUAL_HOME}"
    mkdir -p ${FREESURFER_HOME}/subjects
    touch ${FREESURFER_HOME}/license.txt
    mkdir -p ${FREESURFER_HOME}/models
    wget -O "${FREESURFER_HOME}/models/SuperSynth_August_2025.pth" \
        "https://ftp.nmr.mgh.harvard.edu/pub/dist/lcnpublic/dist/SuperSynth_Iglesias_2025/SuperSynth_August_2025.pth"
    if [ -x "${FREESURFER_HOME}/python/scripts/mri_synthseg" ] && [ ! -e "${FREESURFER_HOME}/bin/mri_synthseg" ]; then
        ln -s "${FREESURFER_HOME}/python/scripts/mri_synthseg" "${FREESURFER_HOME}/bin/mri_synthseg"
    fi

    # --------------------------------------------------------------------------------
    # 5. Convert3D (C3D)
    # --------------------------------------------------------------------------------
    mkdir -p /opt/c3d
    wget https://sourceforge.net/projects/c3d/files/c3d/1.0.0/c3d-1.0.0-Linux-x86_64.tar.gz/download -O /tmp/c3d.tar.gz
    tar -xzf /tmp/c3d.tar.gz -C /opt/c3d --strip-components=1
    rm /tmp/c3d.tar.gz
    mkdir -p /data /output /code

    # --------------------------------------------------------------------------------
    # 6. Optional TORTOISE binaries
    # --------------------------------------------------------------------------------
    TORTOISE_SRC=/opt/container-assets/tortoise
    TORTOISE_HOME=/opt/tortoise
    if [ -d "${TORTOISE_SRC}/bin" ] && [ -f "${TORTOISE_SRC}/bin/CreateGradientNonlinearityBMatrix" ]; then
        mkdir -p "${TORTOISE_HOME}"
        cp -a "${TORTOISE_SRC}/." "${TORTOISE_HOME}/"
        chmod -R a+rX "${TORTOISE_HOME}"
        chmod a+rx "${TORTOISE_HOME}/bin/"* || true
        echo "Installed TORTOISE binaries from ${TORTOISE_SRC} to ${TORTOISE_HOME}"
        "${TORTOISE_HOME}/bin/CreateGradientNonlinearityBMatrix" --help >/dev/null 2>&1 || true
    else
        echo "No local TORTOISE binaries found under ${TORTOISE_SRC}/bin; skipping TORTOISE install."
    fi

    # --------------------------------------------------------------------------------
    # 7. Optional qMRI fitting binary from qmri_nextgen
    # --------------------------------------------------------------------------------
    QMRI_FIT_SRC=/opt/container-assets/qmri-fit
    QMRI_FIT_HOME=/opt/qmri-fit
    QMRI_FIT_BIN=""
    if [ -f "${QMRI_FIT_SRC}/bin/qmri-fit" ]; then
        QMRI_FIT_BIN="${QMRI_FIT_SRC}/bin/qmri-fit"
    elif [ -f "${QMRI_FIT_SRC}/qmri-fit" ]; then
        QMRI_FIT_BIN="${QMRI_FIT_SRC}/qmri-fit"
    elif [ -f "${QMRI_FIT_SRC}/bin/qmri_fit" ]; then
        QMRI_FIT_BIN="${QMRI_FIT_SRC}/bin/qmri_fit"
    elif [ -f "${QMRI_FIT_SRC}/qmri_fit" ]; then
        QMRI_FIT_BIN="${QMRI_FIT_SRC}/qmri_fit"
    fi
    if [ -n "${QMRI_FIT_BIN}" ]; then
        mkdir -p "${QMRI_FIT_HOME}"
        cp -a "${QMRI_FIT_SRC}/." "${QMRI_FIT_HOME}/"
        mkdir -p "${QMRI_FIT_HOME}/bin"
        if [ ! -f "${QMRI_FIT_HOME}/bin/qmri-fit" ] && [ -f "${QMRI_FIT_HOME}/qmri-fit" ]; then
            mv "${QMRI_FIT_HOME}/qmri-fit" "${QMRI_FIT_HOME}/bin/qmri-fit"
        fi
        if [ ! -f "${QMRI_FIT_HOME}/bin/qmri_fit" ] && [ -f "${QMRI_FIT_HOME}/qmri_fit" ]; then
            mv "${QMRI_FIT_HOME}/qmri_fit" "${QMRI_FIT_HOME}/bin/qmri_fit"
        fi
        if [ -f "${QMRI_FIT_HOME}/bin/qmri-fit" ] && [ ! -e "${QMRI_FIT_HOME}/bin/qmri_fit" ]; then
            ln -s qmri-fit "${QMRI_FIT_HOME}/bin/qmri_fit"
        fi
        if [ -f "${QMRI_FIT_HOME}/bin/qmri_fit" ] && [ ! -e "${QMRI_FIT_HOME}/bin/qmri-fit" ]; then
            ln -s qmri_fit "${QMRI_FIT_HOME}/bin/qmri-fit"
        fi
        chmod -R a+rX "${QMRI_FIT_HOME}"
        chmod a+rx "${QMRI_FIT_HOME}/bin/"* || true
        echo "Installed qmri-fit from ${QMRI_FIT_SRC} to ${QMRI_FIT_HOME}"
        "${QMRI_FIT_HOME}/bin/qmri-fit" --help >/dev/null 2>&1 || true
    else
        echo "No local qmri-fit binary found under ${QMRI_FIT_SRC}; skipping qmri-fit install."
    fi
    rm -rf /opt/container-assets

    # --------------------------------------------------------------------------------
    # 8. qmri-neuropipe and Python dependencies
    # --------------------------------------------------------------------------------
    REPO_DIR=/app
    if [ ! -f "${REPO_DIR}/pyproject.toml" ]; then
        REPO_DIR="$(find /app -maxdepth 3 -name pyproject.toml -printf '%h\n' | head -n 1)"
    fi
    if [ -z "${REPO_DIR}" ] || [ ! -f "${REPO_DIR}/pyproject.toml" ]; then
        echo "Could not locate pyproject.toml under /app during Apptainer build." >&2
        find /app -maxdepth 3 -mindepth 1 -print >&2 || true
        exit 1
    fi

    cd "${REPO_DIR}"
    rm -rf build dist *.egg-info src/*.egg-info
    ${CONDA_DIR}/bin/python -m pip install --upgrade pip "setuptools>=68,<82" wheel
    ${CONDA_DIR}/bin/python -m pip install \
        --no-cache-dir \
        --no-compile \
        --prefer-binary \
        dmri-amico
    PYTHON_EXTRAS="{{ PYTHON_EXTRAS }}"
    if [ -n "${PYTHON_EXTRAS}" ]; then
        PACKAGE_SPEC=".[${PYTHON_EXTRAS}]"
    else
        PACKAGE_SPEC="."
    fi
    ${CONDA_DIR}/bin/python -m pip install \
        --no-cache-dir \
        --no-compile \
        --no-build-isolation \
        --prefer-binary \
        "${PACKAGE_SPEC}"
    ${CONDA_DIR}/bin/python -c "import amico; import dmipy; import pkg_resources"

    # Remove package caches and temporary build content before Apptainer
    # compresses the root filesystem into the final SIF.
    micromamba clean --all --yes
    if [ -x "${FSLDIR}/bin/conda" ]; then
        "${FSLDIR}/bin/conda" clean --all --yes
    elif [ -x "${FSLDIR}/bin/mamba" ]; then
        "${FSLDIR}/bin/mamba" clean --all --yes
    elif [ -x "${FSLDIR}/bin/micromamba" ]; then
        "${FSLDIR}/bin/micromamba" clean --all --yes
    fi
    cd /
    rm -rf "${REPO_DIR}"
    # These packages are required only while constructing the image. Runtime
    # libraries declared by FreeSurfer and the other installed tools remain.
    SUDO_FORCE_REMOVE=yes apt-get purge -y --auto-remove build-essential git gnupg sudo bzip2
    apt-get clean
    find ${CONDA_DIR} ${FSLDIR} ${FREESURFER_HOME} \
        -type d \( -name __pycache__ -o -name ".pytest_cache" \) \
        -prune -exec rm -rf {} +
    find ${CONDA_DIR} ${FSLDIR} ${FREESURFER_HOME} \
        -type f \( -name "*.pyc" -o -name "*.pyo" -o -name "*.a" -o -name "*.la" \) \
        -delete
    find ${CONDA_DIR} \
        -type d \( -path "*/include" -o -path "*/Headers" \) \
        -prune -exec rm -rf {} +
    rm -rf \
        /var/lib/apt/lists/* \
        /root/.cache \
        /root/.conda \
        /root/.local \
        /tmp/micromamba-root
    rm -f /usr/local/bin/micromamba


%environment
    export CONDA_DIR=/opt/conda
    export PATH=${CONDA_DIR}/bin:$PATH

    export FSLDIR=/usr/local/fsl
    export PATH=${CONDA_DIR}/bin:${FSLDIR}/bin:$PATH
    export FSLOUTPUTTYPE=NIFTI_GZ

    export FREESURFER_HOME=/usr/local/freesurfer/8.2.0
    export SUBJECTS_DIR=${FREESURFER_HOME}/subjects
    export FS_LICENSE=${FREESURFER_HOME}/license.txt
    export FSFAST_HOME=${FREESURFER_HOME}/fsfast
    export MNI_DIR=${FREESURFER_HOME}/mni
    if [ -f "${FREESURFER_HOME}/SetUpFreeSurfer.sh" ]; then
        . "${FREESURFER_HOME}/SetUpFreeSurfer.sh" >/dev/null 2>&1 || true
    fi
    export PATH=${CONDA_DIR}/bin:${FSLDIR}/bin:${FREESURFER_HOME}/bin:${FREESURFER_HOME}/python/bin:${FREESURFER_HOME}/python/scripts:$PATH

    export C3DPATH=/opt/c3d/bin
    export TORTOISE_HOME=/opt/tortoise
    export QMRI_FIT_HOME=/opt/qmri-fit
    export LD_LIBRARY_PATH=${TORTOISE_HOME}/lib:${QMRI_FIT_HOME}/lib:$LD_LIBRARY_PATH
    export PATH=${CONDA_DIR}/bin:${FSLDIR}/bin:${FREESURFER_HOME}/bin:${FREESURFER_HOME}/python/bin:${FREESURFER_HOME}/python/scripts:${C3DPATH}:${TORTOISE_HOME}/bin:${QMRI_FIT_HOME}/bin:$PATH
    export LC_ALL=C

%runscript
    if [ -f "${FREESURFER_HOME}/SetUpFreeSurfer.sh" ]; then
        . "${FREESURFER_HOME}/SetUpFreeSurfer.sh" >/dev/null 2>&1 || true
    fi
    exec qmri-neuropipe "$@"

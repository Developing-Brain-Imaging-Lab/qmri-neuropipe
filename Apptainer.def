Bootstrap: docker
From: nvidia/cuda:12.2.0-runtime-ubuntu22.04

%labels
    Author Dean
    Version 0.0.1
    Description qmri-neuropipe container (NVIDIA CUDA + FSL + MRtrix3)
    License MIT

%post
    export DEBIAN_FRONTEND=noninteractive
    
    # --------------------------------------------------------------------------------
    # 1. System Dependencies
    # --------------------------------------------------------------------------------
    apt-get update && apt-get install -y \
        wget curl gnupg git build-essential \
        libgl1-mesa-dev libfontconfig1 libfreetype6 \
        libxrender1 libxext6 libsm6 sudo \
        bc dc file

    # --------------------------------------------------------------------------------
    # 2. Miniforge & MRtrix3 & Python Env
    # --------------------------------------------------------------------------------
    export CONDA_DIR=/opt/conda
    export PATH=$CONDA_DIR/bin:$PATH

    # Use Miniforge3 to avoid Anaconda Terms of Service issues
    wget https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/miniforge.sh
    bash /tmp/miniforge.sh -b -p $CONDA_DIR
    rm /tmp/miniforge.sh
    
    # Miniforge already sets conda-forge as priority. Just add mrtrix3.
    conda config --add channels mrtrix3
    conda install -y mrtrix3 python=3.10 pip
    conda clean --all --yes

    # --------------------------------------------------------------------------------
    # 3. FSL (Manual Install)
    # --------------------------------------------------------------------------------
    export FSLDIR=/usr/local/fsl
    export PATH=$FSLDIR/bin:$PATH
    
    curl -fsSL https://fsl.fmrib.ox.ac.uk/fsldownloads/fslconda/releases/fslinstaller.py -o /tmp/fslinstaller.py
    python3 /tmp/fslinstaller.py -d $FSLDIR -q --no_env
    rm /tmp/fslinstaller.py

    # --------------------------------------------------------------------------------
    # 4. Convert3D (C3D)
    # --------------------------------------------------------------------------------
    mkdir -p /opt/c3d
    wget https://sourceforge.net/projects/c3d/files/c3d/1.0.0/c3d-1.0.0-Linux-x86_64.tar.gz/download -O /tmp/c3d.tar.gz
    tar -xzf /tmp/c3d.tar.gz -C /opt/c3d --strip-components=1
    rm /tmp/c3d.tar.gz

    # --------------------------------------------------------------------------------
    # 5. Python Package
    # --------------------------------------------------------------------------------
    # In Apptainer, copying files is done via %files section, usually to root or specific dir.
    # We will assume repo is at /app
    cd /app
    pip install --upgrade pip
    pip install ".[all]"

%files
    . /app

%environment
    export CONDA_DIR=/opt/conda
    export PATH=$CONDA_DIR/bin:$PATH
    
    export FSLDIR=/usr/local/fsl
    export PATH=$FSLDIR/bin:$PATH
    export FSLOUTPUTTYPE=NIFTI_GZ
    
    export C3DPATH=/opt/c3d/bin
    export PATH=$C3DPATH:$PATH
    export LC_ALL=C
    
    # Enable CUDA support in Apptainer (requires --nv flag at runtime)
    # NVIDIA_VISIBLE_DEVICES is handled by Apptainer runtime

%runscript
    exec qmri-neuropipe "$@"
